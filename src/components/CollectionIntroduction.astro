---
import CollectionCountCopy from './CollectionCountCopy.astro';
import ContentLink from './ContentLink.astro';
import { editorialParagraphParts } from '../lib/editorial-links.mjs';
interface Props {
  topic: string;
  paragraphs: string[];
}
const { topic, paragraphs } = Astro.props;
const linkedParagraphs = editorialParagraphParts(`/clipart/${topic}/`, paragraphs);
---

<div class="collection-introduction" data-collection-summary>
  {linkedParagraphs.map((parts) => (
    <p>
      {parts.map(({ href, text }) =>
        href ? (
          <ContentLink class="editorial-inline-link" href={href} relationship="reference">
            {text}
          </ContentLink>
        ) : (
          <CollectionCountCopy topic={topic} text={text} />
        ),
      )}
    </p>
  ))}
</div>
<style>
  .collection-introduction {
    width: 100%;
    min-width: 0;
    max-width: none;
  }
  .collection-introduction p {
    margin: 0;
    max-width: none;
    overflow-wrap: break-word;
  }
  .collection-introduction p + p {
    margin-top: 0.85em;
  }
</style>
