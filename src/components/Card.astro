---
import CardFileActions from './CardFileActions.astro';
import Icon from './Icon.astro';
import ShareButton from './ShareButton.astro';
const { item, subjectLabel } = Astro.props;
---

<article class="art-card" data-id={item.id}>
  <ShareButton item={item} compact />
  <a class="art-picture" href={`/art/${item.id}/`}>
    <img
      title={item.title}
      src={item.webp}
      alt={item.alt}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  </a>
  <div class="card-body">
    {subjectLabel && <a class="home-recent-subject" href={`/clipart/${item.topic}/`}>{subjectLabel}</a>}
    <a class="card-title" href={`/art/${item.id}/`}>
      {item.title}
    </a>
    <CardFileActions id={item.id} title={item.title} webp={item.webp} pdf={item.pdf} />
    <div class="card-actions">
      <a class="button" href={item.editable === false ? `/art/${item.id}/` : `/edit/${item.id}/`}>
        <Icon name={item.editable === false ? 'view' : 'edit'} size={28} />
        <span>{item.editable === false ? 'View' : 'Edit'}</span>
      </a>
    </div>
  </div>
</article>
