---
import { artworkPath } from '../lib/artwork-route.mjs';
import { displayTitle } from '../lib/display-title';
import { imageLoadingPreview, loadingPreviewStyle } from '../lib/image-loading-preview';
import { homeImageCandidates } from '../lib/home-image-candidates';
import CardFileActions from './CardFileActions.astro';
import Icon from './Icon.astro';
import ShareButton from './ShareButton.astro';
const { item, subjectLabel, priority = false, homeResponsive = false } = Astro.props;
const preview = imageLoadingPreview(item);
---

<article class="art-card" data-id={item.id}>
  <ShareButton item={item} compact />
  <a class="art-picture" href={artworkPath(item)} aria-label={item.alt}>
    <img
      title={displayTitle(item.title)}
      src={item.webp}
      srcset={homeResponsive ? homeImageCandidates(item) : undefined}
      data-home-responsive={homeResponsive && homeImageCandidates(item) ? 'true' : undefined}
      alt={item.alt}
      width="400"
      height="400"
      loading={priority ? 'eager' : 'lazy'}
      data-original-deferred={priority ? undefined : 'pending'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
      data-original-placeholder={preview?.url}
      data-original-placeholder-for={preview?.source}
      data-original-preview={priority && preview ? 'pending' : undefined}
      style={priority ? loadingPreviewStyle(preview) : undefined}
    />
  </a>
  <div class="card-body">
    {subjectLabel && (
      <a class="home-recent-subject" href={`/clipart/${item.topic}/`} data-display-title>
        {displayTitle(subjectLabel)}
      </a>
    )}
    <a class="card-title" data-display-title href={artworkPath(item)}>
      {displayTitle(item.title)}
    </a>
    <CardFileActions
      id={item.id}
      title={displayTitle(item.title)}
      webp={item.webp}
      pdf={item.pdf}
    />
    <div class="card-actions">
      <a class="button" href={item.editable === false ? artworkPath(item) : `/edit/${item.id}/`}>
        <Icon name={item.editable === false ? 'view' : 'edit'} size={28} />
        <span>{item.editable === false ? 'View' : 'Edit'}</span>
      </a>
    </div>
  </div>
</article>
