---
import { displayTitle } from '../lib/display-title';
import { imageLoadingPreview } from '../lib/image-loading-preview';
import CardFileActions from './CardFileActions.astro';
import Icon from './Icon.astro';
import ShareButton from './ShareButton.astro';
const { item, subjectLabel, priority = false } = Astro.props;
const preview = imageLoadingPreview(item);
---

<article class="art-card" data-id={item.id}>
  <ShareButton item={item} compact />
  <a class="art-picture" href={`/art/${item.id}/`} aria-label={item.alt}>
    <img
      title={displayTitle(item.title)}
      src={item.webp}
      alt={item.alt}
      width="400"
      height="400"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
      srcset={preview?.url}
      data-catalog-thumbnail={preview ? '' : undefined}
    />
  </a>
  <div class="card-body">
    {subjectLabel && (
      <a class="home-recent-subject" href={`/clipart/${item.topic}/`} data-display-title>
        {displayTitle(subjectLabel)}
      </a>
    )}
    <a class="card-title" data-display-title href={`/art/${item.id}/`}>
      {displayTitle(item.title)}
    </a>
    <CardFileActions
      id={item.id}
      title={displayTitle(item.title)}
      webp={item.webp}
      pdf={item.pdf}
    />
    <div class="card-actions">
      <a class="button" href={item.editable === false ? `/art/${item.id}/` : `/edit/${item.id}/`}>
        <Icon name={item.editable === false ? 'view' : 'edit'} size={28} />
        <span>{item.editable === false ? 'View' : 'Edit'}</span>
      </a>
    </div>
  </div>
</article>
