---
import { displayTitle } from '../lib/display-title';
import { imageLoadingPreview, loadingPreviewStyle } from '../lib/image-loading-preview';
interface Props {
  items: {
    id: string;
    webp: string;
    originalThumb?: string;
    files?: { webp?: { sha256?: string }; thumb?: { sha256?: string } };
    alt: string;
    title: string;
    width: number;
    height: number;
  }[];
  tone?: string;
  prominent?: boolean;
  priority?: boolean;
}
const { items, tone = 'ice', prominent = false, priority = prominent } = Astro.props;
const previews = items.slice(0, 3).map((item) => imageLoadingPreview(item));
---

<div
  class:list={[
    'collection-cover',
    `collection-cover-${tone}`,
    { 'collection-cover-prominent': prominent },
  ]}
>
  <span class="collection-cover-orbit" aria-hidden="true"></span>
  {items.slice(0, 3).map((item, index) => (
    <div class:list={['collection-cover-piece', `collection-cover-piece-${index + 1}`]}>
      <img
        src={item.webp}
        alt={item.alt}
        title={displayTitle(item.title)}
        width={item.width}
        height={item.height}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority && index === 0 ? 'high' : 'low'}
        data-original-placeholder={previews[index]?.url}
        data-original-placeholder-for={previews[index]?.source}
        data-original-preview={priority && previews[index] ? 'pending' : undefined}
        style={priority ? loadingPreviewStyle(previews[index]) : undefined}
        data-cover-artwork={item.id}
      />
    </div>
  ))}
</div>
<style>
  .collection-cover {
    --cover-a: #e8f3ff;
    --cover-b: #c2dafa;
    --cover-c: #84b3e6;
    position: relative;
    isolation: isolate;
    aspect-ratio: 1.6;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 15% 20%, #ffffffbd, transparent 60%),
      linear-gradient(135deg, var(--cover-a), var(--cover-b));
  }
  .collection-cover-sage {
    --cover-a: #eff5eb;
    --cover-b: #d0e2ca;
    --cover-c: #9bb990;
  }
  .collection-cover-peach {
    --cover-a: #fff0df;
    --cover-b: #f7cfaf;
    --cover-c: #e8a46e;
  }
  .collection-cover-rose {
    --cover-a: #fff0f4;
    --cover-b: #f4cdda;
    --cover-c: #d99eb8;
  }
  .collection-cover-lavender {
    --cover-a: #f3eeff;
    --cover-b: #d9cff7;
    --cover-c: #afa1d5;
  }
  .collection-cover-sand {
    --cover-a: #fcf3e3;
    --cover-b: #e8d4af;
    --cover-c: #c5a66f;
  }
  .collection-cover::before {
    content: '';
    position: absolute;
    width: 49%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffffff59;
    left: -14%;
    bottom: -37%;
    border: 22px solid #ffffff35;
  }
  .collection-cover::after {
    content: '';
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cover-c);
    opacity: 0.6;
    right: 46%;
    top: 10%;
    box-shadow:
      17px 15px 0 -2px var(--cover-c),
      -15px 30px 0 -1px #fff;
  }
  .collection-cover-orbit {
    position: absolute;
    inset: 12% 5% 7% 8%;
    border: 1px solid #ffffff94;
    border-radius: 50%;
    transform: rotate(-22deg);
  }
  .collection-cover-piece {
    position: absolute;
    border-radius: 14px;
    border: 1px solid #ffffffcf;
    background: linear-gradient(145deg, #fffffffa, #ffffffe6);
    box-shadow:
      0 7px 14px #203b6017,
      0 2px 1px #ffffff inset;
    padding: 7%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .collection-cover-piece-1 {
    width: 53%;
    height: 78%;
    left: 5%;
    top: 13%;
    transform: rotate(-7deg);
    padding: 3.5%;
    z-index: 2;
  }
  .collection-cover-piece-2 {
    width: 34%;
    height: 44%;
    right: 5%;
    top: 5%;
    transform: rotate(7deg);
    padding: 2%;
    z-index: 1;
  }
  .collection-cover-piece-3 {
    width: 35%;
    height: 44%;
    right: 4%;
    bottom: 4%;
    transform: rotate(-4deg);
    padding: 2%;
    z-index: 3;
  }
  .collection-cover-piece img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 1px #17324d0d);
  }
  .collection-cover-prominent {
    border-radius: 22px;
    min-width: 0;
    width: 100%;
    box-shadow: 0 12px 28px #17324d15;
  }
  @media (prefers-reduced-motion: no-preference) {
    .collection-cover-piece {
      transition: transform 180ms ease;
    }
    :global(a:hover) .collection-cover-piece-1 {
      transform: rotate(-4deg) translateY(-2px);
    }
    :global(a:hover) .collection-cover-piece-2 {
      transform: rotate(4deg);
    }
    :global(a:hover) .collection-cover-piece-3 {
      transform: rotate(-1deg);
    }
  }
</style>
