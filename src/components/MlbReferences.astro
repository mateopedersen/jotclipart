---
import ContentLink from './ContentLink.astro';
import { mlbOfficialRoster } from '../lib/mlb-links.mjs';
import playerIndex from '../../data/jotclipart-mlb-player-references.json';

interface Props {
  topic: string;
  artworkId?: string;
  teamPage?: boolean;
}
const { topic, artworkId, teamPage = false } = Astro.props;
const players =
  (playerIndex as Record<string, { label: string; href: string }[]>)[artworkId ?? ''] ?? [];
const roster = mlbOfficialRoster(topic);
---

{roster && (
  <p class="mlb-references" data-mlb-references>
    <ContentLink class="editorial-inline-link" href={roster}>
      Official MLB team roster
    </ContentLink>
    {players.map(({ label, href }) => (
      <>
        {' · '}
        <ContentLink class="editorial-inline-link" href={href}>
          {label} on MLB.com
        </ContentLink>
      </>
    ))}
    {teamPage && (
      <>
        {' · '}
        <ContentLink class="editorial-inline-link" href="/collection/sports/">
          More sports clipart
        </ContentLink>
      </>
    )}
  </p>
)}

<style>
  .mlb-references {
    margin-block: 0.85rem 1.25rem;
  }
</style>
