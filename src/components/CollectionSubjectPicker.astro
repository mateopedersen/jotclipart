---
import { displayTitle, displayCatalogTitle } from '../lib/display-title';
interface Props {
  topics: { slug: string; keyword: string }[];
}
const { topics } = Astro.props;
---

<div class="collection-subject-navigation">
  <details class="collection-subject-picker mobile-subject-picker">
    <summary>
      <span>Choose A Subject</span>
      <span class="subject-count">{topics.length}</span>
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
        <path
          d="m5 7.5 5 5 5-5"
          stroke="currentColor"
          stroke-width="2.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </summary>
    <nav class="mobile-subject-options" aria-label="Topics in this collection">
      {topics.map((topic) => (
        <a href={`/clipart/${topic.slug}/`} data-display-title>
          {displayCatalogTitle(topic.keyword)}
        </a>
      ))}
    </nav>
  </details>
</div>
<style>
  .collection-subject-navigation {
    max-width: 720px;
    margin-top: 16px;
  }
  .mobile-subject-picker {
    display: block;
    border: 1px solid var(--brand-border);
    border-radius: 14px;
    background: #fff;
    color: var(--brand-ink);
    overflow: clip;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 15px;
    min-height: 48px;
    font-size: 16px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    color: var(--brand-action);
    flex-shrink: 0;
    transition: transform 120ms ease;
  }
  .subject-count {
    margin-inline-start: auto;
    padding: 1px 9px;
    border-radius: 7px;
    background: #ffffff;
    font-variant-numeric: tabular-nums;
  }
  details[open] summary {
    border-bottom: 1px solid var(--brand-soft);
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .mobile-subject-options {
    display: grid;
    gap: 4px;
    padding: 8px;
    max-height: 23rem;
    max-height: min(55svh, 23rem);
    overflow-y: auto;
  }
  .mobile-subject-options a {
    display: block;
    padding: 11px 12px;
    border-radius: 8px;
    color: var(--brand-ink);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .mobile-subject-options a:hover {
    background: var(--brand-page);
  }
  summary:focus-visible,
  .mobile-subject-options a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -3px;
  }
  @media (min-width: 768px) {
    .mobile-subject-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary svg {
      transition: none;
    }
  }
</style>
