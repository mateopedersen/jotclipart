---
interface Props {
  kind: 'brief' | 'composition' | 'identity' | 'review' | 'files' | 'publish';
  id: string;
}
const { kind, id } = Astro.props;
const paint = (name: string) => `url(#${id}-${name})`;
---

<svg
  class="editorial-illustration"
  viewBox="0 0 340 260"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-editorial-illustration={kind}
>
  <defs>
    <linearGradient
      id={`${id}-paper`}
      x1="90"
      y1="30"
      x2="248"
      y2="230"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fff" />
      <stop offset=".6" stop-color="#fafefc" />
      <stop offset="1" stop-color="#e1f3e9" />
    </linearGradient>
    <linearGradient
      id={`${id}-blue`}
      x1="85"
      y1="35"
      x2="248"
      y2="236"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#9cf6c5" />
      <stop offset=".4" stop-color="#4fd28a" />
      <stop offset="1" stop-color="#238750" />
    </linearGradient>
    <linearGradient
      id={`${id}-navy`}
      x1="90"
      y1="35"
      x2="255"
      y2="230"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#409466" />
      <stop offset="1" stop-color="#154b2d" />
    </linearGradient>
    <linearGradient
      id={`${id}-metal`}
      x1="115"
      y1="25"
      x2="197"
      y2="101"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fafefc" />
      <stop offset=".25" stop-color="#a9ccb9" />
      <stop offset=".5" stop-color="#f8fefb" />
      <stop offset=".8" stop-color="#90bba3" />
      <stop offset="1" stop-color="#d9eee2" />
    </linearGradient>
    <linearGradient
      id={`${id}-glass`}
      x1="159"
      y1="76"
      x2="252"
      y2="169"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fafffc" stop-opacity=".9" />
      <stop offset="1" stop-color="#94e8ba" stop-opacity=".35" />
    </linearGradient>
    <pattern id={`${id}-checker`} width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M0 0h24v24H0Z" fill="#fff" />
      <path d="M0 0h12v12H0Zm12 12h12v12H12Z" fill="#e5f3eb" />
    </pattern>
  </defs>
  <ellipse cx="173" cy="238" rx="118" ry="13" fill="#2f6f4c" opacity=".1" />
  {kind === 'brief' && (
    <>
      <g transform="rotate(-7 162 134)">
        <rect x="84" y="30" width="166" height="204" rx="16" fill="#599f79" />
        <rect
          x="80"
          y="24"
          width="166"
          height="204"
          rx="16"
          fill={paint('blue')}
          stroke="#98d7b4"
        />
        <rect x="91" y="35" width="143" height="181" rx="7" fill={paint('paper')} />
        <path d="M129 29h64v14a8 8 0 0 1-8 8h-48a8 8 0 0 1-8-8Z" fill="#6a9e81" />
        <path
          d="M126 24h66v14a8 8 0 0 1-8 8h-50a8 8 0 0 1-8-8Z"
          fill={paint('metal')}
          stroke="#98bea9"
        />
        <rect x="148" y="17" width="22" height="14" rx="7" fill={paint('metal')} stroke="#98bea9" />
        <path d="M112 72h99" stroke="#2c7c50" stroke-width="7" stroke-linecap="round" />
        <g stroke="#aed4bf" stroke-width="4" stroke-linecap="round">
          <path d="M134 105h75M134 145h61M134 185h72" />
        </g>
        <g fill="#e9fcf2" stroke="#85cfa6" stroke-width="1.5">
          <rect x="109" y="95" width="16" height="16" rx="4" />
          <rect x="109" y="135" width="16" height="16" rx="4" />
          <rect x="109" y="175" width="16" height="16" rx="4" />
        </g>
        <path
          d="m112 102 4 4 7-8m-11 44 4 4 7-8"
          stroke="#2fa865"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
      <g transform="rotate(24 256 147)">
        <path d="M248 70h18v131l-9 22-9-22Z" fill="#a4e8c3" stroke="#5eb686" />
        <path d="M248 70h7v129h-7Z" fill="#dbfcea" />
        <path d="M248 201h18l-9 22Z" fill="#e6cfb8" />
        <path d="m254 216 3 7 3-7Z" fill="#2d5941" />
        <rect x="248" y="55" width="18" height="20" rx="5" fill={paint('navy')} />
        <path d="M248 76h18v9h-18Z" fill={paint('metal')} />
      </g>
    </>
  )}
  {kind === 'composition' && (
    <>
      <g transform="rotate(-13 116 136)">
        <rect x="47" y="49" width="130" height="164" rx="13" fill="#b3dbc5" />
        <rect
          x="43"
          y="43"
          width="130"
          height="164"
          rx="13"
          fill={paint('paper')}
          stroke="#bfe1ce"
        />
        <path d="M72 150q32-70 68 0v24H72Z" fill="#c4f0d8" />
        <circle cx="109" cy="104" r="25" fill={paint('blue')} />
        <path d="M65 188h85" stroke="#abd9c0" stroke-width="4" stroke-linecap="round" />
      </g>
      <g transform="rotate(12 236 139)">
        <rect x="177" y="54" width="121" height="161" rx="13" fill="#b5dbc6" />
        <rect
          x="173"
          y="48"
          width="121"
          height="161"
          rx="13"
          fill={paint('paper')}
          stroke="#bfe1ce"
        />
        <path d="M200 157h67l-6-40h-54Z" fill="#8be6b4" />
        <path d="M217 117v-14a16 16 0 0 1 32 0v14" stroke="#3c895f" stroke-width="7" />
        <path d="M194 190h78" stroke="#abd9c0" stroke-width="4" stroke-linecap="round" />
      </g>
      <rect x="107" y="25" width="132" height="190" rx="14" fill="#85cba5" />
      <rect
        x="102"
        y="19"
        width="132"
        height="190"
        rx="14"
        fill={paint('paper')}
        stroke="#a9ddc0"
      />
      <path d="M169 157V99" stroke="#379461" stroke-width="5" stroke-linecap="round" />
      <path
        d="M167 137c-28 2-34-19-33-34 20-1 35 11 33 34Zm5-18c0-25 17-32 33-33 2 19-9 34-33 33Z"
        fill={paint('blue')}
      />
      <g fill="#b3efce" stroke="#6ac894" stroke-width="1.5">
        <ellipse cx="168" cy="73" rx="14" ry="27" />
        <ellipse cx="168" cy="73" rx="14" ry="27" transform="rotate(60 168 73)" />
        <ellipse cx="168" cy="73" rx="14" ry="27" transform="rotate(120 168 73)" />
      </g>
      <circle cx="168" cy="73" r="12" fill={paint('navy')} />
      <path d="M123 184h91" stroke="#abd9c0" stroke-width="4" stroke-linecap="round" />
    </>
  )}
  {kind === 'identity' && (
    <>
      <g transform="rotate(-6 147 139)">
        <path d="M73 40h130l28 29v151H73Z" fill="#b9deca" />
        <path d="M68 34h130l28 29v151H68Z" fill={paint('paper')} stroke="#b1dbc4" />
        <path d="m198 34 28 29h-28Z" fill="#c9ecd9" />
        <rect x="88" y="62" width="77" height="59" rx="8" fill="#e7faf0" />
        <path d="m100 109 18-24 16 18 14-13 9 19Z" fill="#84dead" />
        <path
          d="M91 145h111M91 164h83M91 183h98"
          stroke="#9fd3b6"
          stroke-width="5"
          stroke-linecap="round"
        />
      </g>
      <path
        d="m235 160 45 47a13 13 0 0 1-19 18l-42-48Z"
        fill={paint('navy')}
        stroke="#296946"
        stroke-width="2"
      />
      <path d="m241 177 30 32" stroke="#72b691" stroke-width="4" stroke-linecap="round" />
      <circle cx="211" cy="125" r="53" fill="#3d865e" />
      <circle cx="207" cy="119" r="52" fill={paint('metal')} stroke="#83b99b" stroke-width="2" />
      <circle cx="207" cy="119" r="43" fill={paint('glass')} stroke="#5aa67c" stroke-width="3" />
      <path
        d="M182 100h46M182 116h32M182 132h39"
        stroke="#3e9b68"
        stroke-width="4"
        stroke-linecap="round"
      />
      <path d="M176 104a35 35 0 0 1 20-18" stroke="white" stroke-width="4" stroke-linecap="round" />
    </>
  )}
  {kind === 'review' && (
    <>
      <rect x="54" y="37" width="226" height="182" rx="16" fill="#b4dbc6" />
      <rect x="49" y="31" width="226" height="182" rx="16" fill={paint('paper')} stroke="#a3d4b9" />
      <rect x="62" y="45" width="200" height="153" rx="9" fill={paint('checker')} />
      <path d="M157 181v-73" stroke="#439668" stroke-width="5" stroke-linecap="round" />
      <path
        d="M155 163c-33 1-46-26-44-47 28 2 48 19 44 47Zm7-28c0-31 22-43 45-43 0 25-15 44-45 43Z"
        fill={paint('blue')}
        stroke="#6ec093"
        stroke-width="1.5"
      />
      <path d="m154 155-28-24m39-7 26-20" stroke="#cefae2" stroke-width="2" />
      <g stroke="#3cae6f" stroke-width="3" stroke-linecap="round">
        <path d="M74 78V59h19M231 59h19v19M74 166v19h19M231 185h19v-19" />
      </g>
      <path d="m250 129 45 17v36c0 25-23 43-45 55-22-12-45-30-45-55v-36Z" fill="#a3dbbc" />
      <path
        d="m246 122 43 17v36c0 25-21 42-43 54-22-12-43-29-43-54v-36Z"
        fill={paint('blue')}
        stroke="#98dcb7"
        stroke-width="2"
      />
      <path
        d="m224 173 15 15 28-34"
        stroke="white"
        stroke-width="8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
  {kind === 'files' && (
    <>
      <g transform="rotate(-10 110 128)">
        <path d="M51 41h99l29 31v139H51Z" fill="#9fd3b6" />
        <path d="M47 35h99l29 31v139H47Z" fill={paint('paper')} stroke="#aed8c1" />
        <path d="m146 35 29 31h-29Z" fill="#bee6d0" />
        <rect x="65" y="82" width="91" height="78" rx="8" fill="#dff8ea" />
        <circle cx="91" cy="103" r="10" fill="#76cd9d" />
        <path d="m74 150 26-32 17 20 17-17 13 29Z" fill={paint('blue')} />
        <path d="M68 181h78" stroke="#96caad" stroke-width="5" stroke-linecap="round" />
      </g>
      <g transform="rotate(9 235 128)">
        <path d="M181 41h92l28 30v140H181Z" fill="#9fd3b6" />
        <path d="M177 35h92l28 30v140H177Z" fill={paint('paper')} stroke="#aed8c1" />
        <path d="m269 35 28 30h-28Z" fill="#bee6d0" />
        <rect x="192" y="84" width="88" height="24" rx="6" fill={paint('navy')} />
        <path
          d="M197 127h79M197 143h66M197 159h74M197 181h48"
          stroke="#9fd1b6"
          stroke-width="5"
          stroke-linecap="round"
        />
      </g>
      <path d="M121 205h99l12 19H110Z" fill="#a1d4b8" />
      <path d="M110 224h122v13H110Z" fill={paint('navy')} />
      <path
        d="M170 155v53m-16-16 16 16 16-16"
        stroke="#83d1a6"
        stroke-width="12"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M168 151v53m-16-16 16 16 16-16"
        stroke={paint('blue')}
        stroke-width="10"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
  {kind === 'publish' && (
    <>
      <rect x="51" y="34" width="239" height="169" rx="14" fill="#7cb897" />
      <rect
        x="46"
        y="28"
        width="239"
        height="169"
        rx="14"
        fill={paint('navy')}
        stroke="#76c198"
        stroke-width="2"
      />
      <rect x="57" y="40" width="217" height="144" rx="5" fill="#f4fef9" />
      <path d="M57 45a5 5 0 0 1 5-5h207a5 5 0 0 1 5 5v24H57Z" fill="#dff8ea" />
      <circle cx="70" cy="54" r="4" fill="#42ae73" />
      <path d="M83 54h47M195 54h64" stroke="#94d0af" stroke-width="5" stroke-linecap="round" />
      <g fill="white" stroke="#c4e5d3">
        <rect x="69" y="80" width="56" height="84" rx="5" />
        <rect x="137" y="80" width="56" height="84" rx="5" />
        <rect x="205" y="80" width="56" height="84" rx="5" />
      </g>
      <circle cx="97" cy="109" r="15" fill={paint('blue')} />
      <path d="M149 129V95h31v34Z" fill="#b7e9ce" />
      <path d="m214 128 12-29 14 29Z" fill="#86d5aa" />
      <path
        d="M80 149h33m35 0h33m35 0h33"
        stroke="#b0dbc3"
        stroke-width="4"
        stroke-linecap="round"
      />
      <path d="M46 197h239l31 24H15Z" fill={paint('metal')} />
      <path d="M15 221h301v6a7 7 0 0 1-7 7H22a7 7 0 0 1-7-7Z" fill="#79b494" />
      <path d="M139 202h53l8 10h-69Z" fill="#a8cdb9" />
      <circle cx="270" cy="180" r="37" fill="#b0dfc5" />
      <circle cx="267" cy="175" r="36" fill={paint('blue')} stroke="#a6e6c3" stroke-width="2" />
      <path
        d="m250 175 12 12 23-26"
        stroke="white"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
</svg>
