---
import { displayTitle } from '../lib/display-title';
import { publishedArt } from '../lib/catalog';
import { catalogThumbnailAttributes } from '../lib/image-loading-preview';
import visual from '../../data/browse-library-visual.json';
import CatalogCount from './CatalogCount.astro';

// The menu shares one same-origin image. A replaced or withdrawn source must
// use the current published thumbnail rather than its former cell.
const artwork = visual.pieces.flatMap(({ id, topic, originalSHA256, thumbnailSHA256 }, index) => {
  const item =
    publishedArt.find((item) => item.id === id) ??
    publishedArt.find((item) => item.topic === topic && item.alpha && !item.monochrome);
  if (!item) return [];
  const cell =
    item.id === id &&
    item.files?.webp?.sha256 === originalSHA256 &&
    item.files?.thumb?.sha256 === thumbnailSHA256
      ? `--cell-x:${(index % 3) * 50}%;--cell-y:${(Math.floor(index / 3) * 100) / 3}%`
      : undefined;
  return [{ item, cell }];
});
---

<a class="site-browse-feature" href="/categories/" aria-label="Browse All Clipart Categories">
  <div class="site-browse-preview-copy">
    <strong>Explore the Library</strong>
    <span>School, Food, Music &amp; More</span>
  </div>
  <div
    class="site-browse-preview-art"
    aria-hidden="true"
    style={`--browse-preview-image:url("${visual.url}")`}
  >
    {artwork.map(({ item, cell }) => (
      <span class="site-browse-preview-tile">
        {cell ? (
          <span class="site-browse-preview-piece" title={displayTitle(item.title)} style={cell} />
        ) : (
          <img
            title={displayTitle(item.title)}
            src={item.webp}
            {...catalogThumbnailAttributes(item)}
            width="120"
            height="120"
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
      </span>
    ))}
  </div>
  <span class="site-browse-preview-action">Browse All Subjects</span>
  <span class="site-browse-preview-count">
    <CatalogCount kind="subjects" /> Subjects
  </span>
</a>
