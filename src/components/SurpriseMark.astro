---
const { id = 'surprise', size = 64 } = Astro.props;
const g = `jot-surprise-${id}`;
---

<svg
  class="header-illustration"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${g}-box`} x1="17" y1="30" x2="42" y2="58" gradientUnits="userSpaceOnUse">
      <stop stop-color="#85D4AE" />
      <stop offset=".5" stop-color="#52B788" />
      <stop offset="1" stop-color="#216E4E" />
    </linearGradient>
    <linearGradient id={`${g}-paper`} x1="21" y1="9" x2="42" y2="36" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF" />
      <stop offset="1" stop-color="#EAF7EF" />
    </linearGradient>
    <linearGradient id={`${g}-star`} x1="27" y1="13" x2="39" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFEEC1" />
      <stop offset="1" stop-color="#E5B855" />
    </linearGradient>
  </defs>
  <ellipse cx="32" cy="58" rx="23" ry="3" fill="#123524" opacity=".1" />
  <path d="m12 32 20-7 21 8-2 19-19 9-19-9-1-20Z" fill="#1B5B40" />
  <path d="m12 29 20 8 21-8-21-7-20 7Z" fill="#D8F3DC" stroke="#92CBAA" />
  <g transform="rotate(9 34 23)">
    <rect x="23" y="8" width="24" height="28" rx="4" fill="#9BC6AB" />
    <rect x="21" y="6" width="24" height="28" rx="4" fill={`url(#${g}-paper)`} stroke="#B7DCC5" />
    <path
      d="m33 12 2.4 5 5.6.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8 2.4-5Z"
      fill={`url(#${g}-star)`}
      stroke="#D7AF58"
      stroke-width=".65"
    />
    <path d="m38 34 7-7v4a3 3 0 0 1-3 3h-4Z" fill="#C8E8D4" />
  </g>
  <path d="m12 30 20 8v21l-18-8-2-21Z" fill={`url(#${g}-box)`} stroke="#3D9469" stroke-width=".7" />
  <path d="m32 38 21-8-2 21-19 8V38Z" fill="#2D8B60" />
  <path d="m23 34 6 3v20l-6-2V34Zm13 3 6-2v20l-6 3V37Z" fill="#E8F5DD" />
  <path
    d="m10 27 20 8 2 5-20-8-2-5Zm24 9 20-8 1 5-21 8v-5Z"
    fill="#A7DEB9"
    stroke="#6EBE92"
    stroke-width=".65"
  />
  <path d="m14 35 2 13 5 2" stroke="#B9E8CD" stroke-width="1.4" stroke-linecap="round" />
  <path d="m13 7 1.3 4.1L19 13l-4.7 1.7L13 19l-1.4-4.3L7 13l4.6-1.9L13 7Z" fill="#52B788" />
  <path d="m52 12 .9 3 3.1 1-3.1 1-.9 3-1-3-3-1 3-1 1-3Z" fill="#E5B855" />
  <path
    d="m9 23 3-2m40 3 3 1M21 4l1 3"
    stroke="#83C9A0"
    stroke-width="1.7"
    stroke-linecap="round"
  />
</svg>
