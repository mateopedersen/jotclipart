---
import CatalogCount from './CatalogCount.astro';
import { collectionCountTemplate } from '../lib/collection-count-copy';
import { collectionCountParts } from '../lib/collection-count-tokens.mjs';
interface Props {
  text: string;
  topic: string;
}
const { text, topic } = Astro.props;
const parts = collectionCountParts(collectionCountTemplate(text));
---

{parts.map((part) =>
  typeof part === 'string' ? part : <CatalogCount kind="topic" countKey={topic} unit={part.unit} />,
)}
