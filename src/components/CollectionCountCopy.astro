---
import CatalogCount from './CatalogCount.astro';
import { collectionCountParts } from '../lib/collection-count-tokens.mjs';
interface Props {
  text: string;
  topic: string;
}
const { text, topic } = Astro.props;
// Topic numbers (911, 300, 007, years…) describe the subject. Only an explicit
// inventory placeholder may be replaced with the current catalog count.
const parts = collectionCountParts(text);
---

{parts.map((part) =>
  typeof part === 'string' ? part : <CatalogCount kind="topic" countKey={topic} unit={part.unit} />,
)}
