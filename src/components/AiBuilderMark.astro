---
const { id = 'builder', size = 56 } = Astro.props;
const g = `jot-ai-${id}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 80 80"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={`${g}-frame`}
      x1="17"
      y1="19"
      x2="61"
      y2="68"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#C9EED6" />
      <stop offset=".45" stop-color="#52B788" />
      <stop offset="1" stop-color="#216E4E" />
    </linearGradient>
    <linearGradient
      id={`${g}-glass`}
      x1="22"
      y1="24"
      x2="54"
      y2="57"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#F8FFFA" />
      <stop offset="1" stop-color="#D8F3DC" />
    </linearGradient>
    <linearGradient id={`${g}-wand`} x1="43" y1="11" x2="67" y2="36" gradientUnits="userSpaceOnUse">
      <stop stop-color="#F8E8B9" />
      <stop offset="1" stop-color="#D4AD55" />
    </linearGradient>
  </defs>
  <ellipse cx="39" cy="71" rx="28" ry="4" fill="#123524" opacity=".12" />
  <g transform="rotate(-7 34 42)">
    <rect x="12" y="20" width="48" height="47" rx="9" fill="#174B34" />
    <rect x="10" y="16" width="48" height="47" rx="9" fill={`url(#${g}-frame)`} stroke="#9AD7B3" />
    <rect x="16" y="23" width="36" height="32" rx="5" fill={`url(#${g}-glass)`} />
    <path
      d="M20 49c3-8 9-10 13-6 6-11 10-10 15 6H20Z"
      fill="#52B788"
      stroke="#216E4E"
      stroke-width=".7"
    />
    <path d="M20 49c3-7 6-8 10-5" stroke="#B6E5C7" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="26" cy="32" r="4" fill="#E6C16C" />
    <path d="M19 20h27" stroke="#EEFFF3" stroke-width="1.5" stroke-linecap="round" />
  </g>
  <path d="m44 33 15-20 6 5-16 19-6 2 1-6Z" fill="#174B34" />
  <path
    d="m42 30 15-20 6 5-16 19-6 2 1-6Z"
    fill={`url(#${g}-wand)`}
    stroke="#C69C46"
    stroke-width=".65"
  />
  <path d="m56 12 5 4m-6-1 4 3" stroke="#FFF6D9" stroke-width="1.4" stroke-linecap="round" />
  <path
    d="m62 2 2.1 6.8L71 11l-6.9 2.2L62 20l-2.2-6.8L53 11l6.8-2.2L62 2Z"
    fill="#D8F3DC"
    stroke="#FFFFFF"
    stroke-width="1.1"
  />
  <path d="m72 29 1.1 3.9L77 34l-3.9 1.2L72 39l-1.2-3.8L67 34l3.8-1.1L72 29Z" fill="#D8F3DC" />
  <path d="m42 5 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z" fill="#52B788" />
  <path d="M63 45h5m-2.5-2.5v5" stroke="#A8DDC0" stroke-width="1.5" stroke-linecap="round" />
</svg>
