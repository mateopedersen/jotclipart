---
import { artworkPath } from '../lib/artwork-route.mjs';
import '../styles/original-image-loading.css';
import '../styles/global.css';
import '../styles/display-titles.css';
import '../styles/select-controls.css';
import DownloadPanel from '../components/DownloadPanel.astro';
import CookieNotice from '../components/CookieNotice.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AiBuilderMark from '../components/AiBuilderMark.astro';
import StudioMark from '../components/StudioMark.astro';
import '../styles/site-header.css';
import '../styles/site-display-restoration.css';
import '../styles/site-search.css';
import HeaderIllustration from '../components/HeaderIllustration.astro';
import BrowsePreview from '../components/BrowsePreview.astro';
import { cuteSurpriseIndex } from '../lib/surprise-catalog';
import { SURPRISE_INDEX_VERSION } from '../lib/cute-discovery';
import { structuredData } from '../lib/structured-data';
import { pageGraph } from '../lib/page-seo';
import { pageSocialImage } from '../lib/social-images';
import { siteNavigationScript } from '../lib/site-navigation-inline.mjs';
import { cookieStartupScript } from '../../scripts/cookie-startup.mjs';
import '../styles/image-information.css';
// These styles belong to the page, even before the sharing module is requested.
import '../share/trigger.css';
import '../share/dialog.css';
const {
  title = 'Clipart for Personal & Classroom Projects',
  description = 'Explore original seasonal clipart. Edit colors and layers, then download WebP and printable PDF files.',
  noindex = false,
  wide = false,
  contentClass = '',
  image = '',
  imageAlt = title,
  imageWidth,
  imageHeight,
  socialPage = Astro.url.pathname,
} = Astro.props;
const socialImage = pageSocialImage(socialPage, {
  src: image,
  alt: imageAlt,
  width: imageWidth,
  height: imageHeight,
});
const socialImageUrl = new URL(socialImage.src, 'https://ultraclipart.com').href;
const readingFont =
  Astro.url.pathname === '/for-teachers/' || Astro.url.pathname.startsWith('/guides/');
const preloadInterfaceFont = !readingFont && !/^\/(?:art|edit)\//.test(Astro.url.pathname);
const surprisePicks = cuteSurpriseIndex.slice(0, 48);
const browseLinks = [
  {
    label: 'Explore clipart',
    href: '/',
    description: 'Browse illustrations by subject.',
    icon: 'discover',
  },
  {
    label: 'Categories',
    href: '/categories/',
    description: 'Browse every subject in the library.',
    icon: 'grid',
  },
  {
    label: 'Collections',
    href: '/collections/',
    description: 'Related subjects in one collection.',
    icon: 'layers',
  },
  {
    label: 'New clipart',
    href: '/new/',
    description: 'The latest additions to the collection.',
    icon: 'spark',
  },
  {
    label: 'Black & White',
    href: '/black-and-white/',
    description: 'Simple outlines and printable artwork.',
    icon: 'contrast',
  },
];
const resourceLinks = [
  {
    label: 'Project guides',
    href: '/guides/',
    description: 'Make something, step by step.',
    icon: 'book',
  },
  {
    label: 'For Teachers',
    href: '/for-teachers/',
    description: 'Ideas for the classroom.',
    icon: 'school',
  },
  {
    label: 'Print size calculator',
    href: '/print-size/',
    description: 'Choose a size that prints clearly.',
    icon: 'print',
  },
  {
    label: 'About UltraClipart',
    href: '/about/',
    description: 'Meet the team and learn about the site.',
    icon: 'info',
  },
];
const current = (path: string) => (Astro.url.pathname === path ? 'page' : undefined);
const browseCurrent =
  browseLinks.some((link) => Astro.url.pathname === link.href) ||
  Astro.url.pathname.startsWith('/clipart/') ||
  Astro.url.pathname.startsWith('/art/');
const resourcesCurrent =
  resourceLinks.some((link) => Astro.url.pathname === link.href) ||
  Astro.url.pathname.startsWith('/guides/');
const canonical = new URL(Astro.url.pathname, 'https://ultraclipart.com').href;
const releaseRevision = /^[a-f0-9]{40}$/.test(import.meta.env.PUBLIC_RELEASE_REVISION ?? '')
  ? import.meta.env.PUBLIC_RELEASE_REVISION
  : 'local';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={siteNavigationScript}></script>
    <link rel="preconnect" href="https://assets.ultraclipart.com" />
    <script>
      import { initOriginalImageLoading } from '../scripts/original-image-loading';
      initOriginalImageLoading();
    </script>
    <script>
      import { initNavigationWarmth } from '../scripts/navigation-warmth';
      initNavigationWarmth();
      import { initCuteSurprise } from '../scripts/cute-surprise';
      initCuteSurprise();
    </script>
    <script is:inline set:html={cookieStartupScript} />
    {preloadInterfaceFont && (
      <link
        rel="preload"
        href="/fonts/inter/inter-latin-wght-3100e775e861-cache-v2.woff2"
        as="font"
        type="font/woff2"
        fetchpriority="high"
        crossorigin
      />
    )}
    {readingFont && (
      <link
        rel="preload"
        href="/fonts/source-sans-3/source-sans-3-latin-19143dca0759.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <meta name="viewport" content="width=device-width" />
    <meta name="build-revision" content={releaseRevision} />
    <title>{title} | UltraClipart</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'}
    />
    <meta property="og:title" content={title + ' | UltraClipart'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UltraClipart" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImage.alt} />
    {socialImage.type && <meta property="og:image:type" content={socialImage.type} />}
    {socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title + ' | UltraClipart'} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <meta name="theme-color" content="#2865D2" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script
      type="application/ld+json"
      set:html={structuredData(
        pageGraph({ canonical, title, description, noindex, primaryImage: image }),
      )}
    />
    <slot name="head" />
    <noscript>
      <style is:inline>
        img[data-original-preview] {
          background-image: none !important;
        }
      </style>
    </noscript>
  </head>
  <body id="page-top" class:list={{ 'reader-page': readingFont }}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a class="brand site-brand" href="/" aria-label="UltraClipart home">
          <img src="/logo.svg" width="36" height="40" alt="" />
          <span>UltraClipart</span>
        </a>
        <button
          class="menu-button site-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="navigation"
        >
          <svg
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path class="site-menu-lines" d="M4 6h16M4 12h16M4 18h16" />
            <path class="site-menu-close" d="m6 6 12 12M6 18 18 6" />
          </svg>
          <span>Menu</span>
        </button>
        <nav id="navigation" class="site-navigation" aria-label="Main navigation">
          <div class="site-navigation-links">
            <div class="site-nav-disclosure" data-nav-disclosure>
              <button
                id="site-browse-toggle"
                type="button"
                class="site-nav-trigger"
                data-current={browseCurrent ? 'true' : undefined}
                aria-expanded="false"
                aria-controls="site-browse-panel"
              >
                Browse
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m5 8 5 5 5-5" />
                </svg>
              </button>
              <div id="site-browse-panel" class="site-dropdown site-browse-dropdown" hidden>
                <div class="site-dropdown-heading">
                  <span>The clipart collection</span>
                  <a href="/categories/">
                    View all <span aria-hidden="true">→</span>
                  </a>
                </div>
                <div class="site-browse-content">
                  <div class="site-dropdown-links">
                    {browseLinks.map((link) => (
                      <a
                        href={link.href}
                        class="site-dropdown-link"
                        aria-current={current(link.href)}
                        aria-label={link.label}
                      >
                        <span class="site-link-icon" data-icon={link.icon}>
                          <HeaderIllustration kind={link.icon} />
                        </span>
                        <span>
                          <strong>{link.label}</strong>
                          <small>{link.description}</small>
                        </span>
                        <svg
                          class="site-link-arrow"
                          width="17"
                          height="17"
                          viewBox="0 0 20 20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M4 10h12m-5-5 5 5-5 5" />
                        </svg>
                      </a>
                    ))}
                  </div>
                  <BrowsePreview />
                </div>
              </div>
            </div>
            <div class="site-nav-disclosure" data-nav-disclosure>
              <button
                id="site-resources-toggle"
                type="button"
                class="site-nav-trigger"
                data-current={resourcesCurrent ? 'true' : undefined}
                aria-expanded="false"
                aria-controls="site-resources-panel"
              >
                Resources
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path d="m5 8 5 5 5-5" />
                </svg>
              </button>
              <div id="site-resources-panel" class="site-dropdown site-resources-dropdown" hidden>
                <div class="site-dropdown-heading">
                  <span>A little help with your next idea</span>
                </div>
                <div class="site-dropdown-links">
                  {resourceLinks.map((link) => (
                    <a
                      href={link.href}
                      class="site-dropdown-link"
                      aria-current={current(link.href)}
                      aria-label={link.label}
                    >
                      <span class="site-link-icon" data-icon={link.icon}>
                        <HeaderIllustration kind={link.icon} />
                      </span>
                      <span>
                        <strong>{link.label}</strong>
                        <small>{link.description}</small>
                      </span>
                      <svg
                        class="site-link-arrow"
                        width="17"
                        height="17"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M4 10h12m-5-5 5 5-5 5" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <a
            class="site-surprise-link site-surprise-desktop"
            href={artworkPath(surprisePicks[0])}
            aria-label="Surprise me. Open a random illustration"
            data-surprise-art={JSON.stringify(surprisePicks)}
            data-surprise-source={`/surprise-picks.json?v=${SURPRISE_INDEX_VERSION}-${import.meta.env.PUBLIC_RELEASE_REVISION || 'local'}`}
          >
            <HeaderIllustration kind="surprise" instance="header-art-desktop" />
            <span>
              <strong>Surprise me</strong>
              <span>A little reason to smile</span>
            </span>
          </a>
          <div class="site-navigation-actions">
            <a href="/create/" class="site-studio-link" aria-current={current('/create/')}>
              <StudioMark size={34} />
              <span>Clipart Studio</span>
            </a>
            <a
              href="/ai-clipart-generator/"
              class="site-ai-link"
              aria-current={current('/ai-clipart-generator/')}
            >
              <AiBuilderMark id="header" size={34} />
              <span>AI Clipart Builder</span>
              <span class="site-new-badge">New</span>
            </a>
            <a
              href="/favorites/"
              class="favorites-link site-favorites-link"
              aria-label="Favorites"
              aria-current={current('/favorites/')}
            >
              <svg
                width="23"
                height="23"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.2 4.8a5.2 5.2 0 0 0-7.4 0l-.8.8-.8-.8a5.2 5.2 0 0 0-7.4 7.4L12 21l8.2-8.8a5.2 5.2 0 0 0 0-7.4Z" />
              </svg>
              <span>Favorites</span>
            </a>
          </div>
        </nav>
        <a
          class="site-surprise-link site-surprise-mobile"
          href={artworkPath(surprisePicks[0])}
          aria-label="Surprise me. Open a random illustration"
          data-surprise-art=""
          data-surprise-source={`/surprise-picks.json?v=${SURPRISE_INDEX_VERSION}-${import.meta.env.PUBLIC_RELEASE_REVISION || 'local'}`}
        >
          <HeaderIllustration kind="surprise" />
          <span>
            <strong>Surprise me</strong>
            <span>A little reason to smile</span>
          </span>
        </a>
      </div>
    </header>
    <script is:inline set:html={siteNavigationScript}></script>
    <main id="main" class:list={['container', contentClass, { wide }]}>
      <slot />
    </main>
    <DownloadPanel />
    <SiteFooter />
    <CookieNotice />
    <script>
      import '../share/entry';
    </script>
    <p id="download-status" class="download-status" role="status" aria-live="polite" hidden></p>
    <script>
      import '../scripts/downloads';
      import { initSearchSuggestions } from '../scripts/search-suggestions';
      import { initImageInformation } from '../scripts/image-information';
      initSearchSuggestions();
      initImageInformation();
    </script>
  </body>
</html>
<style>
  .download-status {
    position: fixed;
    inset: auto 18px 18px auto;
    z-index: 100;
    max-width: min(420px, calc(100vw - 36px));
    padding: 14px 18px;
    margin: 0;
    border: 1px solid #bacce5;
    border-radius: 12px;
    background: #fff;
    color: #142442;
    box-shadow: 0 5px 24px #14244224;
    font-size: 14px;
    line-height: 1.5;
  }
  .download-status[hidden] {
    display: none;
  }
  :global(a[download][aria-busy='true']) {
    cursor: progress;
    opacity: 0.7;
  }
</style>
