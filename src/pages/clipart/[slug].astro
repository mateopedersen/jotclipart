---
import { artworkURL } from '../../lib/artwork-route.mjs';
import { displayArtworkTitle, topicPageTitle } from '../../lib/display-title';
import { imageLoadingPreview } from '../../lib/image-loading-preview';
import { imageObject } from '../../lib/image-schema';
import { collectionMetaDescription } from '../../lib/collection-meta.mjs';
import { curatedDefinitions } from '../../lib/curated-collection-policy.mjs';
import { structuredData, breadcrumbs } from '../../lib/structured-data';
import collectionCopy from '../../../data/collection-copy.json';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import CollectionGalleryHeading from '../../components/CollectionGalleryHeading.astro';
import RelatedCollections from '../../components/RelatedCollections.astro';
import CollectionIntroduction from '../../components/CollectionIntroduction.astro';
import NbaReferences from '../../components/NbaReferences.astro';
import MlbReferences from '../../components/MlbReferences.astro';
import {
  availableTopics,
  topicArt,
  slugify,
  clustersForTopic,
  reviewedCollectionIntroductions,
  reviewedCollectionParagraphs,
} from '../../lib/catalog';
export function getStaticPaths() {
  return availableTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const copy = collectionCopy[topic.slug as keyof typeof collectionCopy];
const reviewedIntro = reviewedCollectionIntroductions.get(topic.slug);
const paragraphs = reviewedCollectionParagraphs.get(topic.slug);
if (!paragraphs) throw new Error(`Missing expanded introduction: ${topic.slug}`);
const featured = new Map(copy?.featured.map((id, index) => [id, index]));
const items = topicArt(topic.slug).sort(
  (a, b) => (featured.get(a.id) ?? 999) - (featured.get(b.id) ?? 999),
);
const topicReady = items.length > 0 && items.every((item) => item.indexable && item.published);
const firstLoadingPreview = items[0] && imageLoadingPreview(items[0]);
const title = topicPageTitle(topic.keyword);
const description = reviewedIntro;
if (!description) throw new Error(`Missing topic introduction: ${topic.slug}`);
const searchDescription = collectionMetaDescription(description);
const curatedMemberships = curatedDefinitions
  .filter((group) => group.topicSlugs.includes(topic.slug))
  .slice(0, 3);
---

<Layout
  title={title}
  description={searchDescription.text}
  image={items[0]?.webp}
  imageAlt={items[0]?.alt}
  imageWidth={items[0]?.width}
  imageHeight={items[0]?.height}
  noindex={!topicReady}
>
  {firstLoadingPreview && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={firstLoadingPreview.url}
      fetchpriority="high"
    />
  )}
  <script
    slot="head"
    type="application/ld+json"
    set:html={structuredData(
      breadcrumbs([
        { name: 'Home', path: '/' },
        { name: 'Categories', path: '/categories/' },
        { name: title, path: `/clipart/${topic.slug}/` },
      ]),
    )}
  />
  {topicReady && items.length > 0 && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={structuredData({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        url: `https://jotclipart.com/clipart/${topic.slug}/`,
        description,
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: items.length,
          itemListElement: items.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: artworkURL(item),
            name: displayArtworkTitle(item.title),
            item: imageObject(item),
          })),
        },
      })}
    />
  )}
  <section class="hero">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/categories/">Categories</a> /{' '}
      <a href={`/collection/${slugify(topic.cluster)}/`}>{topic.cluster}</a>
    </div>
    <h1 data-display-title>{title}</h1>
    <CollectionIntroduction topic={topic.slug} paragraphs={paragraphs} />
    <NbaReferences topic={topic.slug} teamPage />
    <MlbReferences topic={topic.slug} teamPage />
    <div class="chips">
      {clustersForTopic(topic)
        .filter((cluster) => cluster !== topic.cluster)
        .map((cluster) => (
          <a href={`/collection/${slugify(cluster)}/`}>{cluster}</a>
        ))}
    </div>
    {curatedMemberships.length > 0 && (
      <nav class="chips" aria-label="Featured in these collections">
        {curatedMemberships.map((group) => (
          <a href={`/collection/${group.slug}/`}>{group.title}</a>
        ))}
      </nav>
    )}
  </section>
  <CollectionGalleryHeading topic={topic.slug} />
  {items.length ? (
    <div class="gallery">
      {items.map((item, index) => (
        <Card item={item} priority={index === 0} />
      ))}
    </div>
  ) : (
    <div class="empty">
      <h2>No Artwork Available Yet</h2>
      <p>No artwork has been released for this topic yet.</p>
      <a class="button primary" href="/new/">
        Explore available artwork
      </a>
    </div>
  )}
  <RelatedCollections topic={topic.slug} />
  <nav class="collection-help" aria-label="Artwork help">
    <a href="/guides/webp-pdf-and-editable-projects/">Image &amp; PDF guide</a>
    <a href="/print-size/">Check print size</a>
    <a href="/license/">Usage license</a>
  </nav>
</Layout>

<style>
  .collection-help {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--brand-soft);
    font-weight: 600;
  }
  .collection-help a {
    padding-block: 0.5rem;
  }
</style>
