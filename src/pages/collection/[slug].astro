---
import { displayCatalogTitle, topicPageTitle } from '../../lib/display-title';
import { imageLoadingPreview } from '../../lib/image-loading-preview';
import { imageObject } from '../../lib/image-schema';
import { structuredData } from '../../lib/structured-data';
import { contentLink } from '../../lib/content-link';
import { editorialParagraphParts } from '../../lib/editorial-links.mjs';
import { curatedDefinitions } from '../../lib/curated-collection-policy.mjs';
import Layout from '../../layouts/Layout.astro';
import CatalogCount from '../../components/CatalogCount.astro';
import CollectionCover from '../../components/CollectionCover.astro';
import Card from '../../components/Card.astro';
import CollectionSubjectPicker from '../../components/CollectionSubjectPicker.astro';
import {
  publishedArt as art,
  availableTopics,
  availableClusters,
  slugify,
  topicInCluster,
} from '../../lib/catalog';
import { categoryCollections } from '../../lib/category-directory';
import { curatedCollections } from '../../lib/curated-collections';
export function getStaticPaths() {
  return [
    ...availableClusters.map((cluster) => ({
      params: { slug: slugify(cluster) },
      props: { cluster, collectionSlug: slugify(cluster) },
    })),
    ...curatedCollections.map((g) => ({
      params: { slug: g.slug },
      props: { cluster: g.title, collectionSlug: g.slug },
    })),
  ];
}
const { cluster, collectionSlug = slugify(cluster) } = Astro.props;
const curated = curatedCollections.find((g) => g.slug === collectionSlug);
const primary = categoryCollections.find((g) => g.slug === collectionSlug);
const ts = curated?.topics ?? availableTopics.filter((t) => topicInCluster(t, cluster));
const topicIDs = new Set(ts.map((t) => t.slug));
const items = curated?.items ?? art.filter((a) => topicIDs.has(a.topic));
const previews = curated?.previews ?? primary?.previews ?? items.slice(0, 3);
const title = displayCatalogTitle(curated?.title ?? primary?.title ?? cluster);
const pageTitle = `${topicPageTitle(title)} Collection`;
const firstLoadingPreviews = previews.flatMap((item) => {
  const preview = imageLoadingPreview(item);
  return preview ? [preview] : [];
});
const summary =
  curated?.summary ??
  primary?.description ??
  `Browse the subjects in the ${title} clipart collection.`;
const paragraphs = curated?.paragraphs ??
  primary?.paragraphs ?? [
    summary,
    'Explore {{artworkCount}} illustrations across the subjects below. Choose a subject to browse its complete gallery.',
  ];
const linkedParagraphs = editorialParagraphParts(`/collection/${collectionSlug}/`, paragraphs);
const relatedCollections = curatedDefinitions
  .filter((group) => group.slug !== collectionSlug)
  .map((group) => ({
    group,
    shared: group.topicSlugs.filter((slug) => topicIDs.has(slug)).length,
  }))
  .filter(({ group, shared }) => shared >= 2 && shared * 3 >= group.topicSlugs.length)
  .sort((a, b) => b.shared / b.group.topicSlugs.length - a.shared / a.group.topicSlugs.length)
  .slice(0, 3);
const visibleArtwork = [
  ...new Map([...previews, ...items.slice(0, 32)].map((a) => [a.id, a])).values(),
];
---

<Layout
  title={pageTitle}
  description={summary}
  noindex={items.length === 0}
  image={previews[0]?.webp}
  imageAlt={previews[0]?.alt}
  imageWidth={previews[0]?.width}
  imageHeight={previews[0]?.height}
>
  <Fragment slot="head">
    {firstLoadingPreviews.map((preview) => (
      <link rel="preload" as="image" href={preview.url} fetchpriority="high" />
    ))}
  </Fragment>
  <section class="themed-collection">
    <a class="collection-back" href="/collections/">
      ← All Collections
    </a>
    <div class="themed-collection-hero">
      <div>
        <h1 data-display-title>{pageTitle}</h1>
        {linkedParagraphs.map((parts) => (
          <p>
            {parts.map(({ href, text }) => {
              if (href)
                return (
                  <a class="editorial-inline-link" href={contentLink(href).href} set:text={text} />
                );
              return text
                .split(/(\{\{artworkCount\}\})/g)
                .map((part) =>
                  part === '{{artworkCount}}' ? (
                    <CatalogCount kind="collection-artworks" countKey={collectionSlug} />
                  ) : (
                    part
                  ),
                );
            })}
          </p>
        ))}
        <p class="themed-collection-inventory">
          <CatalogCount kind="collection-subjects" countKey={collectionSlug} unit="subject" />
        </p>
      </div>
      {previews.length === 3 && (
        <CollectionCover
          items={previews}
          tone={curated?.tone ?? primary?.tone ?? primary?.color}
          prominent
        />
      )}
    </div>
    <h2>Explore the subjects</h2>
    <CollectionSubjectPicker topics={ts} />
    {relatedCollections.length > 0 && (
      <nav aria-label="Related collections" class="collection-related-navigation">
        <h2>Related collections</h2>
        <div class="chips">
          {relatedCollections.map(({ group }) => (
            <a href={`/collection/${group.slug}/`}>{group.title}</a>
          ))}
        </div>
      </nav>
    )}
  </section>
  {items.length > 0 ? (
    <section aria-labelledby="collection-artwork-heading">
      <h2 id="collection-artwork-heading">A selection from this collection</h2>
      <div class="gallery">
        {items.slice(0, 32).map((item) => (
          <Card item={item} />
        ))}
      </div>
    </section>
  ) : (
    <div class="empty">
      <h2>In preparation</h2>
      <p>No illustrations are available in this collection yet.</p>
      <a href="/new/">Browse Available Artwork</a>
    </div>
  )}
  <div class="browse-more">
    <p>
      Choose a subject above to explore all{' '}
      <CatalogCount kind="collection-artworks" countKey={collectionSlug} /> illustrations in this
      collection.
    </p>
    <a class="button primary" href="/collections/">
      Explore More Collections
    </a>
  </div>
  <script
    type="application/ld+json"
    set:html={structuredData({
      '@context': 'https://schema.org',
      '@graph': visibleArtwork.map((a) => imageObject(a)),
    })}
  />
</Layout>
<style>
  .collection-related-navigation {
    margin-block-start: 1.5rem;
  }
  .themed-collection {
    padding: 24px 0 28px;
  }
  .collection-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .themed-collection-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 42px;
    margin-bottom: 32px;
  }
  .themed-collection-hero h1 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 20px;
    color: var(--brand-ink);
  }
  .themed-collection-hero p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--brand-ink);
    margin: 0 0 16px;
    max-width: 65ch;
  }
  .themed-collection-hero .themed-collection-inventory {
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-ink);
  }
  .themed-collection h2,
  #collection-artwork-heading {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 18px;
    color: var(--brand-ink);
  }
  @media (max-width: 720px) {
    .themed-collection-hero {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .themed-collection-hero > :global(.collection-cover) {
      max-width: 480px;
    }
    .themed-collection-hero h1 {
      font-size: 34px;
    }
    .themed-collection-hero p {
      font-size: 16px;
    }
  }
</style>
