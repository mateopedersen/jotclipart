---
import Layout from '../../layouts/Layout.astro';
import Editor from '../../components/Editor.astro';
import { art } from '../../lib/catalog';
import { editorDisplayPreview } from '../../lib/image-loading-preview';
import { editorScreen } from '../../lib/editor-screen';
import { renderArtworkScope } from '../../lib/delivery-build-scope';
export function getStaticPaths() {
  return renderArtworkScope(art).map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const editorItem = editorScreen(item);
const displayPreview = item.sourceType === 'raster' && editorDisplayPreview(editorItem);
---

<Layout
  title={`Edit ${item.title}`}
  noindex={true}
  wide={true}
  image={item.webp}
  imageAlt={item.alt}
  imageWidth={item.width}
  imageHeight={item.height}
>
  <Fragment slot="head">
    {displayPreview && (
      <link rel="preload" as="image" href={displayPreview.url} fetchpriority="high" />
    )}
    {item.sourceType === 'raster' && !displayPreview && (
      <script
        id="editor-original-source"
        type="application/json"
        set:html={JSON.stringify({ url: item.webp, ...item.files.webp }).replaceAll('<', '\\u003c')}
      />
    )}
    <script>
      import { prefetchVerified } from '../../editor/verified-fetch';
      import { editorPreviewReady } from '../../editor/preview-ready';
      const record = document.getElementById('editor-original-source');
      if (record?.textContent) {
        try {
          prefetchVerified(
            JSON.parse(record.textContent),
            'webp',
            location.origin,
            editorPreviewReady(),
          );
        } catch {
          /* The editor repeats source validation and shows the error. */
        }
      }
    </script>
  </Fragment>
  <Editor art={editorItem} />
</Layout>
